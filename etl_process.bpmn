<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ETL" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.11.1">
  <bpmn:error id="Error_load" name="Ошибка загрузки" errorCode="LOAD_FAILED" />
  <bpmn:collaboration id="Collaboration_ETL">
    <bpmn:participant id="P_proj" name="src_projects (БД источника 1)" />
    <bpmn:participant id="P_hr" name="src_hr (БД источника 2)" />
    <bpmn:participant id="P_dw" name="dw_company (хранилище данных)" />
    <bpmn:participant id="P_etl" name="ETL-процесс: сбор и объединение данных в ХД" processRef="Process_ETL" />
    <bpmn:messageFlow id="MF1" sourceRef="P_proj" targetRef="T_ext_proj" />
    <bpmn:messageFlow id="MF2" sourceRef="P_hr" targetRef="T_ext_hr" />
    <bpmn:messageFlow id="MF3" sourceRef="T_upsert" targetRef="P_dw" />
    <bpmn:messageFlow id="MF4" sourceRef="SP_load" targetRef="P_dw" />
    <bpmn:group id="Group_0emdaum" categoryValueRef="CategoryValue_1p5bmvo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ETL" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_orch" name="Оркестратор ETL (автоматически)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ext_proj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ext_hr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_norm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_exact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_exact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_pat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fuzzy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fz_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_canon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_upsert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_dq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_dq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_steward" name="Дата-стюард">
        <bpmn:flowNodeRef>U_st</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Запуск: 02:00 или вручную">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 2 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_open" name="Открыть запуск в etl_run_log">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G_split">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_ext_proj" name="Извлечь данные из src_projects">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ext_hr" name="Извлечь данные из src_hr">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G_join">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_norm" name="Многокритериальная очистка и нормализация ФИО">
      <bpmn:documentation>Комплекс предварительных проверок и нормализации:
1. Очистка титулов и обращений (товарищ, тов., господин, г-н, Dr., Mr., проф., сэр и др.)
2. Выделение иностранных приставок к фамилиям (фон, ван, де, де ла, фон дер, аль- и др.)
3. Нормализация омоглифов (латиница/кириллица: A, B, C, E, H, K, M, O, P, T, X)
4. Исправление ошибочной раскладки клавиатуры (QWERTY &lt;-&gt; ЙЦУКЕН)
5. Исправление ошибок оптического распознавания (OCR: rn-&gt;m, cl-&gt;d, 0-&gt;о)
6. Разбор структуры: одиночные, двойные, тройные, четверные имена (Анна-Мария, Шарль Луи Наполеон)
7. Инвариантность расстановки (Иванов Иван, Иван Иванов, Шарль де Голль, инициалы)
8. Этимологический анализ корней имён (Георгий / Юрий / Егор, Иван / Ян, Ксения / Оксана)</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_exact" name="match_key найден в dim_person?">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_exact" name="Присоединить (метод exact: точное совпадение + этимология имён)">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_pat" name="Фамилия + инициалы: один кандидат?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_pat" name="Присоединить (метод pattern: фамилия + инициалы)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_fuzzy" name="Многокритериальное сравнение (14 проверок фамилий)">
      <bpmn:documentation>Исчерпывающее сравнение по 14 критериям верификации фамилий:
1. Точное посимвольное совпадение
2. Регистронезависимое совпадение
3. Unicode NFKD/NFKC и снятие диакритики (Müller -&gt; Muller)
4. Омоглифы (буквы-двойники кириллицы/латиницы)
5. Прямая и обратная транслитерация (ГОСТ/BGN: Кузнецов &lt;-&gt; Kuznetsov)
6. Иностранные дворянские приставки (слитно / раздельно: ван Бетховен / Бетховен)
7. Составные и дефисные фамилии (перестановка компонентов: Мамин-Сибиряк)
8. Гендерное выравнивание лемм (-ов/-ова, -ский/-ская, -ин/-ина)
9. Орфографическая редукция гласных (ё/е, э/е, й/и, ъ/ь)
10. Редукция удвоенных согласных (Филиппов &lt;-&gt; Филипов)
11. Фонетический русский Metaphone / Soundex
12. Опечатка раскладки клавиатуры (QWERTY &lt;-&gt; ЙЦУКЕН)
13. Оптические ошибки распознавания (OCR)
14. Метрики Дамерау-Левенштейна и Яро-Винклера</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_score" name="Оценка сходства?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_fz_ok" name="Присоединить (метод fuzzy: score ≥ 0.92)">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_review" name="Отправить в etl_review_queue (0.80 - 0.92)">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_new" name="Создать нового человека (метод new: score &#60; 0.80)">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M1">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_canon" name="Определить каноническое ФИО">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="T_upsert" name="Записать в dim_person и alias">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SP_load" name="Загрузка в ХД (одна транзакция)">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:startEvent id="S_in">
        <bpmn:outgoing>F37</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_dims" name="Загрузить справочники и стек проектов">
        <bpmn:incoming>F37</bpmn:incoming>
        <bpmn:outgoing>F38</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_facts" name="Загрузить факты: назначения, зарплаты, компетенции">
        <bpmn:incoming>F38</bpmn:incoming>
        <bpmn:outgoing>F39</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_in">
        <bpmn:incoming>F39</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F37" sourceRef="S_in" targetRef="T_dims" />
      <bpmn:sequenceFlow id="F38" sourceRef="T_dims" targetRef="T_facts" />
      <bpmn:sequenceFlow id="F39" sourceRef="T_facts" targetRef="E_in" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_err" name="Ошибка загрузки" attachedToRef="SP_load">
      <bpmn:outgoing>F29</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_B_err" errorRef="Error_load" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_rb" name="Откатить транзакцию, пометить запуск failed">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_fail" name="Загрузка не выполнена">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_E_fail" errorRef="Error_load" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_dq" name="Проверки качества данных">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_dq" name="Проверки пройдены?">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_queue" name="Есть спорные ФИО в очереди?">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_st" name="Проверить спорные ФИО">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_apply" name="Применить решение стюарда и догрузить данные">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M2">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_close" name="Закрыть запуск: success, статистика">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_ok" name="Данные загружены">
      <bpmn:incoming>F36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S1" targetRef="T_open" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_open" targetRef="G_split" />
    <bpmn:sequenceFlow id="F03" sourceRef="G_split" targetRef="T_ext_proj" />
