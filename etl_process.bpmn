    <bpmn:sequenceFlow id="F33" sourceRef="U_st" targetRef="T_apply" />
    <bpmn:sequenceFlow id="F34" sourceRef="T_apply" targetRef="M2" />
    <bpmn:sequenceFlow id="F35" sourceRef="M2" targetRef="T_close" />
    <bpmn:sequenceFlow id="F36" sourceRef="T_close" targetRef="E_ok" />
    <bpmn:textAnnotation id="TextAnnotation_List">
      <bpmn:text>РЕЕСТР ПРОВЕРОК ФИО:
1. Очистка титулов/званий (товарищ, господин, Dr., Mr., проф., сэр)
2. Иностранные приставки (фон, ван, де, де ла, фон дер, аль-)
3. Многосоставные имена (1-4 части: Анна-Мария, Шарль Луи Наполеон)
4. Инвариантность расстановки (F L, L F M, M L F, инициалы)
5. Этимологические гнезда (Георгий/Юрий/Егор, Иван/Ян, Ксения/Оксана)
6. 14 критериев проверки фамилий:
• Точное совпадение и регистронезависимость
• Unicode NFKC и снятие диакритики (Müller -&gt; Muller)
• Омоглифы кириллицы/латиницы (A, B, C, E, H, K, M, O, P, T, X)
• Мультиязычная транслитерация (Кузнецов &lt;-&gt; Kuznetsov)
• Иностранные приставки (слитно/раздельно: ван Бетховен / Бетховен)
• Составные фамилии (перестановка: Мамин-Сибиряк)
• Гендерное выравнивание (-ов/-ова, -ский/-ская)
• Орфографическая редукция гласных (ё/е, э/е, й/и, ъ/ь)
• Редукция удвоенных согласных (Филиппов &lt;-&gt; Филипов)
• Фонетический русский Metaphone / Soundex
• Опечатка раскладки клавиатуры (QWERTY &lt;-&gt; ЙЦУКЕН)
• Оптические ошибки распознавания (OCR: rn/m, cl/d, 0/o)
• Дистанция Дамерау-Левенштейна (транспозиции букв)
• Коэффициент Яро-Винклера и N-gram сходство</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_norm" sourceRef="T_norm" targetRef="TextAnnotation_List" />
    <bpmn:association id="Assoc_fuzzy" sourceRef="T_fuzzy" targetRef="TextAnnotation_List" />
  </bpmn:process>
  <bpmn:category id="Category_0bgg55b">
    <bpmn:categoryValue id="CategoryValue_1p5bmvo" />
  </bpmn:category>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_ETL">
      <bpmndi:BPMNShape id="P_etl_di" bpmnElement="P_etl" isHorizontal="true">
        <dc:Bounds x="160" y="140" width="3260" height="850" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_orch_di" bpmnElement="L_orch" isHorizontal="true">
        <dc:Bounds x="190" y="140" width="3230" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_steward_di" bpmnElement="L_steward" isHorizontal="true">
