    <bpmn:sequenceFlow id="F10" name="Нет" sourceRef="G_exact" targetRef="G_pat" />
    <bpmn:sequenceFlow id="F11" name="Да" sourceRef="G_pat" targetRef="T_pat" />
    <bpmn:sequenceFlow id="F12" name="Нет" sourceRef="G_pat" targetRef="T_fuzzy" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_fuzzy" targetRef="G_score" />
    <bpmn:sequenceFlow id="F14" name="≥ 0,92" sourceRef="G_score" targetRef="T_fz_ok" />
    <bpmn:sequenceFlow id="F15" name="0,80 – 0,92 (спорно)" sourceRef="G_score" targetRef="T_review" />
    <bpmn:sequenceFlow id="F16" name="&#60; 0,80" sourceRef="G_score" targetRef="T_new" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_exact" targetRef="M1" />
